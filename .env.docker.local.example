# Copie ce fichier vers .env.docker.local pour tes secrets locaux.
# Ce fichier est ignore par Git via la regle .env.*.local.

# Exemple: endpoint Ollama host explicite (si necessaire)
# OLLAMA_BASE_URL=http://192.168.1.20:11434

# Exemple: URI MongoDB privee
# MONGODB_URI=mongodb://user:password@localhost:27017/ollama_chat
