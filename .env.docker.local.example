# Copie ce fichier vers .env.docker.local pour tes secrets locaux.
# Ce fichier est ignore par Git via la regle .env.*.local.

# Exemple: Ollama tourne sur l'hote (hors conteneur) plutot que via le service
# compose "ollama". host.docker.internal est resolu grace a extra_hosts dans
# docker-compose.yaml ; une IP de reseau local (ex: 192.168.1.20) fonctionne aussi.
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Exemple: URI MongoDB privee avec identifiants, joignable depuis le conteneur
# (host.docker.internal, pas localhost qui designerait le conteneur lui-meme)
# MONGODB_URI=mongodb://user:password@host.docker.internal:27017/ollama_chat
