# Cible du proxy /api/ollama/[...path] : nom du service Ollama sur le réseau Docker
OLLAMA_HOST=http://ollama:11434
# Conservé pour les routes granulaires historiques (health, tags, ps, ...) : même valeur en conteneur
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=llama3.2
# Nom du service Mongo sur le réseau Docker (jamais localhost : ce serait le conteneur lui-même)
MONGODB_URI=mongodb://mongo:27017/ollama_chat
